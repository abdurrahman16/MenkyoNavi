APP_NAME=MenkyoNavi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#
# Database
# --------
# Default local development uses SQLite (database/database.sqlite).
# Preferred production / shared-dev database is MySQL 8+.
#
# Safe MySQL switch (do this only after MySQL is installed and reachable):
#   1. Create an empty database named menkyo_navi (utf8mb4).
#   2. Create a dedicated MySQL user with privileges on that database only.
#   3. Copy your real credentials into .env (never invent or commit passwords).
#   4. Keep a backup of database/database.sqlite before migrating data.
#   5. Set the MySQL variables below, then run:
#        php artisan config:clear
#        php artisan migrate
#   6. If you need to move existing SQLite rows, export/import deliberately
#      (mysqldump / custom transfer). Do not drop production databases.
#
# Leave DB_CONNECTION=sqlite until MySQL is available. Do not install a full
# database server without operator approval.
#
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# MySQL 8+ example (uncomment and replace placeholders with real values):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=menkyo_navi
# DB_USERNAME=your_mysql_username
# DB_PASSWORD=your_mysql_password
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: set SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Behind a reverse proxy / load balancer (production), set one of:
#   TRUSTED_PROXIES=*
#   TRUSTED_PROXIES=10.0.0.1,10.0.0.2
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#
# Mail
# ----
# Local default is log (writes to storage/logs; does not send externally).
# Production: use smtp, ses, postmark, or resend with a verified From domain.
#
# Required production variables (fill with real provider values; never commit secrets):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.example.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your_smtp_username
#   MAIL_PASSWORD=your_smtp_password
#   MAIL_SCHEME=tls          # or leave null / use provider docs
#   MAIL_FROM_ADDRESS=noreply@your-verified-domain.example
#   MAIL_FROM_NAME="${APP_NAME}"
#
# After configuring a real transport, verify privately with:
#   php artisan menkyo:verify-mail-delivery
# (Use --force in production only after confirming the recipient is correct.)
#
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#
# Public registration
# -------------------
# Leave unset for automatic behavior:
#   local/testing → open (log mailer is OK for developers)
#   production/staging → open only when MAIL_MAILER delivers externally
# Set true/false to force open/closed.
#
# REGISTRATION_ENABLED=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#
# MenkyoNavi / AdSense readiness
# ------------------------------
# Keep ADSENSE_ENABLED=false until you have a real publisher ID, site approval,
# privacy/CMP readiness, and explicit authorization to show ads.
# Never use a fake publisher ID. Never load live AdSense scripts during development.
#
# You may set ADSENSE_PUBLISHER_ID alone so /ads.txt can be verified by Google
# while ADSENSE_ENABLED remains false (no ad scripts load).
#
ADSENSE_ENABLED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_CLIENT_ID=
ADSENSE_AUTO_ENABLED=true
ADSENSE_MANUAL_ENABLED=false
ADSENSE_REQUIRE_CONSENT=true
ADSENSE_CONSENT_GRANTED=false

#
# Technical SEO / Google Search Console
# -------------------------------------
# Set APP_URL to the real HTTPS production origin before launch.
# MENKYO_ALLOW_INDEXING: leave empty to follow APP_ENV=production.
#   Set false on any publicly reachable staging host.
# GOOGLE_SITE_VERIFICATION: paste the HTML-tag token from Search Console only.
#   Leave empty until you verify ownership. Never invent a token.
# Optional DNS/file verification does not require this variable.
#
# MENKYO_ALLOW_INDEXING=
# GOOGLE_SITE_VERIFICATION=


# Optional manual ad unit IDs (numeric). Leave empty until units exist in AdSense.
ADSENSE_SLOT_CONTENT_MID=
ADSENSE_SLOT_CONTENT_BOTTOM=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_ARTICLE_INLINE=
ADSENSE_SLOT_EXAM_LEFT=
ADSENSE_SLOT_EXAM_RIGHT=
ADSENSE_SLOT_EXAM_BOTTOM=

# Local-only labeled placeholders for layout spacing checks (never production):
ADS_LAYOUT_PREVIEW=false

# Demo practice uses unpublished sample questions.
# Leave unset to allow it in local/testing and keep it off in other environments.
# Set true only as an explicit development override. Set false to hide demo start.
# EXAM_DEMO_ENABLED=

# Private Contact Us recipient (server-only; never rendered in public HTML).
CONTACT_RECIPIENT_EMAIL=
# Legacy aliases (optional):
MENKYO_CONTACT_EMAIL=
CONTACT_EMAIL=
